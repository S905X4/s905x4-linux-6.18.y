// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * HK1 RBOX X4, S905X4, 4GB variant.
 * Wiring and usable-memory boundary: original sc2_ah212_4g vendor DT.
 * Native eMMC is exposed for read-only inventory, not installation.
 */
/dts-v1/;
#include "meson-sc2.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/sound/meson-g12a-tohdmitx.h>

/ {
	model = "HK1 RBOX X4 (S905X4, 4GB)";
	compatible = "hk1,rbox-x4", "amlogic,sc2";

	aliases {
		serial0 = &uart_b;
		serial1 = &uart_e;
		mmc0 = &sd_emmc_b;
		ethernet0 = &ethmac;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

	/* The original 4GB DT exposes 0xf0000000 bytes below the MMIO hole. */
	memory@0 {
		device_type = "memory";
		reg = <0 0 0 0xf0000000>;
	};

	leds {
		compatible = "gpio-leds";

		led-status {
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio GPIOD_11 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

	i2c-panel {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio GPIOA_14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio GPIOA_15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;

		display-controller@24 {
			compatible = "fdhisi,fd6551";
			reg = <0x24>;
			fdhisi,digits = <4 3 2 1>;
			default-brightness-level = <8>;
			#address-cells = <1>;
			#size-cells = <0>;

			display {
				function = "display";
			};

			led@0 {
				reg = <0>;
				function = "alarm";
			};

			led@1 {
				reg = <1>;
				function = "usb";
			};

			led@2 {
				reg = <2>;
				function = "pause";
			};

			led@3 {
				reg = <3>;
				function = "play";
			};

			led@4 {
				reg = <4>;
				function = "colon";
			};

			led@5 {
				reg = <5>;
				function = "lan";
			};

			led@6 {
				reg = <6>;
				function = "wlan";
			};
		};
	};

	spdif_dit: spdif-transmitter {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	sound {
		compatible = "amlogic,axg-sound-card";
		model = "HK1 RBOX X4";
		audio-aux-devs = <&tdmout_c>;
		audio-routing = "SPDIFOUT_A IN 0", "FRDDR_A OUT 3",
				"TDMOUT_C IN 1", "FRDDR_B OUT 2",
				"TDM_C Playback", "TDMOUT_C OUT";
		clocks = <&clkc CLKID_MPLL2>, <&clkc CLKID_MPLL0>,
			 <&clkc CLKID_MPLL1>;
		assigned-clocks = <&clkc CLKID_MPLL2>, <&clkc CLKID_MPLL0>,
				  <&clkc CLKID_MPLL1>;
		assigned-clock-parents = <0>, <0>, <0>;
		assigned-clock-rates = <294912000>, <270950400>, <393216000>;

		dai-link-0 {
			sound-dai = <&frddr_a>;
		};

		dai-link-1 {
			sound-dai = <&frddr_b>;
		};

		dai-link-2 {
			sound-dai = <&spdifout_a>;
			codec {
				sound-dai = <&spdif_dit>;
			};
		};

		dai-link-3 {
			sound-dai = <&tdmif_c>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;
			codec {
				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_C>;
			};
		};

		dai-link-4 {
			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
			codec {
				sound-dai = <&hdmi_tx>;
			};
		};
	};

	wifi32k: wifi-32k-clock {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio GPIOX_6 GPIO_ACTIVE_LOW>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
		power-off-delay-us = <100000>;
	};

	vddcpu: regulator-vddcpu {
		compatible = "pwm-regulator";
		pwms = <&pwm_ij 1 1500 0>;
		regulator-name = "vddcpu0";
		regulator-min-microvolt = <689000>;
		regulator-max-microvolt = <1049000>;
		regulator-always-on;
		regulator-settling-time-us = <200>;
		regulator-max-step-microvolt = <30000>;
		voltage-table = <1049000 0>, <1039000 3>, <1029000 6>,
			<1019000 9>, <1009000 12>, <999000 14>, <989000 17>,
			<979000 20>, <969000 23>, <959000 26>, <949000 29>,
			<939000 31>, <929000 34>, <919000 37>, <909000 40>,
			<899000 43>, <889000 45>, <879000 48>, <869000 51>,
			<859000 54>, <849000 56>, <839000 59>, <829000 62>,
			<819000 65>, <809000 68>, <799000 70>, <789000 73>,
			<779000 76>, <769000 79>, <759000 81>, <749000 84>,
			<739000 87>, <729000 89>, <719000 92>, <709000 95>,
			<699000 98>, <689000 100>;
	};

	cpu_opp_table: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-100000000 {
			opp-hz = /bits/ 64 <100000000>;
			opp-microvolt = <779000>;
		};
		opp-250000000 {
			opp-hz = /bits/ 64 <250000000>;
			opp-microvolt = <779000>;
		};
		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <779000>;
		};
		opp-667000000 {
			opp-hz = /bits/ 64 <667000000>;
			opp-microvolt = <799000>;
		};
		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <799000>;
		};
		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <809000>;
		};
		opp-1404000000 {
			opp-hz = /bits/ 64 <1404000000>;
			opp-microvolt = <839000>;
		};
		opp-1500000000 {
			opp-hz = /bits/ 64 <1500000000>;
			opp-microvolt = <849000>;
		};
		opp-1608000000 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <879000>;
		};
		opp-1704000000 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <919000>;
		};
		opp-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <959000>;
		};
		opp-1908000000 {
			opp-hz = /bits/ 64 <1908000000>;
			opp-microvolt = <989000>;
		};
		opp-2004000000 {
			opp-hz = /bits/ 64 <2004000000>;
			opp-microvolt = <1019000>;
		};
	};

	thermal-zones {
		cpu-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&cpu_temp>;
			trips {
				cpu_warm: cpu-warm {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_hot: cpu-hot {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_critical: cpu-critical {
					temperature = <105000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map0 {
					trip = <&cpu_hot>;
					cooling-device = <&cpu0 0 8>;
				};
			};
		};
		ddr-thermal {
			polling-delay = <2000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&ddr_temp>;
			trips {
				ddr-warm {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};
				ddr-hot {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				ddr-critical {
					temperature = <105000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Low firmware and BL31 carveouts retained from the SC2 port. */
		firmware@0 {
			reg = <0 0 0 0x1000000>;
			no-map;
		};

		/* Stock secmon alloc-ranges: never make secure memory reusable. */
		secmon@5000000 {
			reg = <0 0x05000000 0 0x03400000>;
			no-map;
		};

		secmon@10000000 {
			reg = <0 0x10000000 0 0x00200000>;
			no-map;
		};

		/* Stock fixed DSP/scanout pools: firmware ownership is unverified. */
		dsp-firmware@30000000 {
			reg = <0 0x30000000 0 0x00800000>;
			no-map;
		};

		framebuffer@df800000 {
			reg = <0 0xdf800000 0 0x00800000>;
			no-map;
		};
		/* Stock ramoops@7400000 overlaps secmon; do not map it here. */
	};
};

&uart_b {
	status = "okay";
};

&vpu {
	status = "okay";
};

&gpu {
	status = "okay";
};

&cec {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&cec_b_h_pins>;
};

&hdmi_tx {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
};

&audiobus {
	status = "okay";
};

&spdifout_a {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spdifout_h_pins>;
};

&tdmif_c {
	status = "okay";
};

&ir {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&remote_input_pins>;
	linux,rc-map-name = "rc-hk1-rbox-x4";
};

&sd_emmc_b {
	status = "okay";
	pinctrl-names = "default", "clk-gate";
	pinctrl-0 = <&sdcard_pins>;
	pinctrl-1 = <&sdcard_clk_gate_pins>;
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <50000000>;
	voltage-ranges = <3300 3300>;
	no-1-8-v;
	disable-wp;
	cd-gpios = <&gpio GPIOC_6 GPIO_ACTIVE_LOW>;
};

/* Userspace must force this MMC device read-only before inventory tools run. */
&sd_emmc_c {
	status = "okay";
	pinctrl-names = "default", "clk-gate";
	pinctrl-0 = <&emmc_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	voltage-ranges = <3300 3300>;
	non-removable;
	disable-wp;
	no-sd;
	no-sdio;
};

&ethmac {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&eth_pins>;
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	amlogic,tx-delay-ns = <2>;
};

&mdio_mux {
	status = "okay";
};

&ext_mdio {
	external_phy: ethernet-phy@0 {
		reg = <0>;
		max-speed = <1000>;
		reset-gpios = <&gpio GPIOZ_15 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		reset-assert-us = <20000>;
		reset-deassert-us = <50000>;
		/* Use PHY polling; vendor IRQ 0x154 is not a GPIO binding index. */
	};
};

&usb {
	status = "okay";
};

&dwc3 {
	/* SC2 combo PHY supplies the lane, reference PLL and CR-bus tuning. */
	maximum-speed = "super-speed";
	snps,dis_enblslpm_quirk;
	snps,dis-u2-freeclk-exists-quirk;
	snps,dis_u3_susphy_quirk;
	snps,dis-del-phy-power-chg-quirk;
};

&cpu0 {
	clocks = <&clkc CLKID_CPU_CLK>, <&clkc CLKID_CPU_CLK_DYN>,
		 <&clkc CLKID_SYS_PLL>, <&clkc CLKID_DSU_CLK>,
		 <&clkc CLKID_DSU_CLK_FINAL>, <&clkc CLKID_PWM_J_GATE>;
	clock-names = "core", "low", "high", "dsu", "dsu-pre", "vddcpu-pwm";
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vddcpu>;
	#cooling-cells = <2>;
};

&cpu1 {
	clocks = <&clkc CLKID_CPU_CLK>, <&clkc CLKID_CPU_CLK_DYN>,
		 <&clkc CLKID_SYS_PLL>, <&clkc CLKID_DSU_CLK>,
		 <&clkc CLKID_DSU_CLK_FINAL>, <&clkc CLKID_PWM_J_GATE>;
	clock-names = "core", "low", "high", "dsu", "dsu-pre", "vddcpu-pwm";
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vddcpu>;
	#cooling-cells = <2>;
};

&cpu2 {
	clocks = <&clkc CLKID_CPU_CLK>, <&clkc CLKID_CPU_CLK_DYN>,
		 <&clkc CLKID_SYS_PLL>, <&clkc CLKID_DSU_CLK>,
		 <&clkc CLKID_DSU_CLK_FINAL>, <&clkc CLKID_PWM_J_GATE>;
	clock-names = "core", "low", "high", "dsu", "dsu-pre", "vddcpu-pwm";
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vddcpu>;
	#cooling-cells = <2>;
};

&cpu3 {
	clocks = <&clkc CLKID_CPU_CLK>, <&clkc CLKID_CPU_CLK_DYN>,
		 <&clkc CLKID_SYS_PLL>, <&clkc CLKID_DSU_CLK>,
		 <&clkc CLKID_DSU_CLK_FINAL>, <&clkc CLKID_PWM_J_GATE>;
	clock-names = "core", "low", "high", "dsu", "dsu-pre", "vddcpu-pwm";
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vddcpu>;
	#cooling-cells = <2>;
};

&pwm_ij {
	status = "okay";
};

&clkc {
	assigned-clocks = <&clkc CLKID_DSU_CLK>,
		<&clkc CLKID_DSU_CLK_DYN0_SEL>, <&clkc CLKID_DSU_CLK_DYN0>,
		<&clkc CLKID_DSU_CLK_DYN>, <&clkc CLKID_DSU_CLK_FINAL>;
	assigned-clock-parents = <&clkc CLKID_CPU_CLK>,
		<&clkc CLKID_GP1_PLL>, <&clkc CLKID_DSU_CLK_DYN0_SEL>,
		<&clkc CLKID_DSU_CLK_DYN0>, <&clkc CLKID_DSU_CLK_DYN>;
};

&sd_emmc_a {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_pins>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	non-removable;
	no-sd;
	no-mmc;
	no-1-8-v;
	keep-power-in-suspend;
	max-frequency = <50000000>;
	voltage-ranges = <3300 3300>;
	post-power-on-delay-ms = <100>;
	mmc-pwrseq = <&wifi_pwrseq>;
};

&pwm_ef {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_e_pins>;
	assigned-clocks = <&clkc CLKID_PWM_E_MUX>;
	assigned-clock-parents = <&clkc CLKID_FCLK_DIV3>;
};

&uart_e {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart_e_pins>;
	uart-has-rtscts;

	bluetooth {
		compatible = "realtek,rtl8821cs-bt", "realtek,rtl8723bs-bt";
		enable-gpios = <&gpio GPIOX_17 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&gpio GPIOX_19 GPIO_ACTIVE_HIGH>;
		clocks = <&wifi32k>;
		clock-names = "lpo";
		max-speed = <1500000>;
	};
};
